{
  "repo": "CzzzzzzJ/mdldm-maitian",
  "url": "https://github.com/CzzzzzzJ/mdldm-maitian",
  "name": "mdldm-maitian",
  "description": "麦田：自媒体多平台发布中控与数据监控（B站/抖音/小红书/视频号/YouTube/X）",
  "version": "0.3.0",
  "license": "MIT",
  "author": "麦当 mdldm",
  "language": "JavaScript (ESM)",
  "platform": "macOS only",
  "engines": {
    "node": ">=22.5"
  },
  "default_branch": "main",
  "stargazers_count": 335,
  "forks_count": 114,
  "created_at": "2026-11-14T03:59:22Z",
  "pushed_at": "2026-11-16T12:27:07Z",
  "verified_at": "2026-11-17",
  "note": "star/fork/pushed_at 为 2026-11-17 GitHub API 快照；实时值以 --refresh 为准。本项目仅 macOS 可用。",
  "ecosystem": {
    "publisher_repo": "https://github.com/CzzzzzzJ/mdldm-maitian-publisher",
    "publisher_note": "本包不携带各平台适配器代码；adapter 在姊妹仓库，通过 bridge :8765 调用"
  },
  "requirements": [
    "macOS（硬约束）",
    "Node.js ≥ 22.5（用到内置 node:sqlite）",
    "Google Chrome（CDP 端口 9333）",
    "专用 Chrome profile（chrome-profile/，各平台登录态存放于此）",
    "可选：NAS（SMB 共享）、飞书群机器人 webhook、cloudflared 隧道"
  ],
  "commands": [
    {
      "cmd": "node src/demo.mjs",
      "desc": "假数据大屏 demo，无需任何凭据"
    },
    {
      "cmd": "node src/init.mjs",
      "desc": "安装向导：检查环境、生成 config.json、装开机自启、打开各平台登录页"
    },
    {
      "cmd": "node src/hub.mjs plan [工程目录]",
      "desc": "登记进分发计划"
    },
    {
      "cmd": "node src/hub.mjs run <工程目录> [--only x,zsz] [--force] [--now]",
      "desc": "发一期；--now 让站点课程立即上线"
    },
    {
      "cmd": "node src/hub.mjs status [id] [--logs]",
      "desc": "查状态"
    },
    {
      "cmd": "node src/hub.mjs sync <id> [--only a,b]",
      "desc": "取链接、写发布记录、回填 md"
    },
    {
      "cmd": "node src/hub.mjs mark <id> <平台> <状态> [备注] [--url 链接]",
      "desc": "手动改状态"
    },
    {
      "cmd": "node src/hub.mjs adopt <工程目录>",
      "desc": "登记已发的期（不上传）"
    },
    {
      "cmd": "node src/hub.mjs metrics [id]",
      "desc": "采流量并发日报"
    },
    {
      "cmd": "node src/hub.mjs followers",
      "desc": "采粉丝"
    },
    {
      "cmd": "node src/hub.mjs review <id> [天数] [--notify]",
      "desc": "复盘卡片"
    },
    {
      "cmd": "node src/hub.mjs weekly [--notify]",
      "desc": "周报"
    },
    {
      "cmd": "node src/hub.mjs board",
      "desc": "同步到飞书多维表格"
    },
    {
      "cmd": "node src/hub.mjs daemon",
      "desc": "常驻守护进程"
    },
    {
      "cmd": "bash scripts/install.sh",
      "desc": "一键安装向导"
    },
    {
      "cmd": "bash scripts/install-launchd.sh",
      "desc": "装开机自启（可加 --tunnel 装 cloudflared 隧道）"
    }
  ],
  "web_ui": {
    "port": 8787,
    "demo_port": 8788,
    "key_required": true,
    "remote_access_options": [
      "cloudflared 固定域名（推荐）",
      "飞书验证码登录（零配置）",
      "快速隧道（每次重启地址变）"
    ]
  },
  "privacy": {
    "no_password_stored": true,
    "chromium_profile_isolated": true,
    "gitignore": [
      "config.json",
      "data/",
      "chrome-profile/"
    ],
    "read_only_creator_data": true
  }
}
